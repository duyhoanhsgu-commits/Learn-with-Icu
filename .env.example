# Application Settings
PROJECT_NAME="Learn with Icu RAG API"
VERSION="0.1.0"
APP_DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Vector Store Configuration (Qdrant or pgvector)
VECTOR_STORE_TYPE=qdrant  # qdrant or pgvector
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_documents

# Storage Configuration
STORAGE_TYPE=local  # local or s3
UPLOAD_DIR=./uploads

# Embeddings & LLM Settings
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL_NAME=gpt-4o-mini
RESEARCH_SYNTHESIS_MODEL_NAME=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="learn-with-icu"
